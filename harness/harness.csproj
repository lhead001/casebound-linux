    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <KitDir Condition="'$(KitDir)'==''">../src/CaseboundKit</KitDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(KitDir)/CaseboundKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../spec/position-key-test-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
