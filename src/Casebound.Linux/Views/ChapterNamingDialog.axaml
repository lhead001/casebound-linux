<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Casebound.Views.ChapterNamingDialog"
        Title="Name chapters" Width="760" Height="560" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <TextBlock Text="Name chapters" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Grid Grid.Row="1" ColumnDefinitions="*,20,*">
      <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="Front matter, then a numbered run, then back matter. One name per line."/>
        <TextBlock Text="Front matter (first files)" Classes="caption"/>
        <TextBox x:Name="FrontBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Watermark="Opening Credits&#x0a;Prologue"/>
        <Grid ColumnDefinitions="*,8,110">
          <StackPanel><TextBlock Text="Numbered run" Classes="caption"/><TextBox x:Name="PatternBox" Text="Chapter {n}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Starts at" Classes="caption"/><NumericUpDown x:Name="StartBox" Value="1" Minimum="0" Maximum="9999" FormatString="0"/></StackPanel>
        </Grid>
        <TextBlock Text="Numbers" Classes="caption"/>
        <ComboBox x:Name="StyleBox" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem>Digits — Chapter 1</ComboBoxItem>
          <ComboBoxItem>Words — Chapter One</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Back matter (last files)" Classes="caption"/>
        <TextBox x:Name="BackBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Watermark="Epilogue&#x0a;End Credits"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Use titles from tags" Click="FromTags_Click"/>
          <Button Content="Use file names" Click="FromFiles_Click"/>
        </StackPanel>
      </StackPanel>
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <TextBlock x:Name="PreviewHeader" Text="Preview" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Border Grid.Row="1" Classes="card"><ListBox x:Name="PreviewList" Background="Transparent"/></Border>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Content="Cancel" Click="Cancel_Click"/>
      <Button Content="Apply" Classes="accent" Click="Apply_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
